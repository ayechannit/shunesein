# Postgres connection string. Required. On Vercel (serverless - each
# invocation can open its own connection pool), use Supabase's connection
# pooler URL (Settings > Database > Connection pooling, port 6543,
# "Transaction" mode) instead of the direct connection (port 5432) shown
# below, to avoid exhausting the database's connection limit under load.
DB_URL=postgresql://user:password@host:5432/dbname

# Caps how many connections each running instance's pool can open. Only
# needs raising if you have good reason to; the default is sized for
# serverless instances sharing one pooled database.
DB_POOL_MAX=5

# Secret used to sign/verify JWTs. Required - set a long random value in
# Vercel. The app now refuses to start if this is unset (no insecure
# fallback default).
JWT_SECRET=

NODE_ENV=production

# Comma-separated list of allowed frontend origins, e.g. your Vercel
# frontend URL. Optional - omitting it allows any origin.
CORS_ORIGIN=https://your-frontend.vercel.app

# Only used for local `npm run dev` / `npm start`; ignored on Vercel.
PORT=5000
