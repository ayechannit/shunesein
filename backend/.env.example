# Postgres connection string (e.g. Supabase "Connection string" from
# Settings > Database). Required.
DB_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign/verify JWTs. Required - set a long random value in
# Vercel; do not rely on the insecure code default in production.
JWT_SECRET=

NODE_ENV=production

# Comma-separated list of allowed frontend origins, e.g. your Vercel
# frontend URL. Optional - omitting it allows any origin.
CORS_ORIGIN=https://your-frontend.vercel.app

# Only used for local `npm run dev` / `npm start`; ignored on Vercel.
PORT=5000
